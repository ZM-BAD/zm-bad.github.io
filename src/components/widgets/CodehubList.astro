---
// 移植自 _includes/widgets/codehub_list
import { site } from '../../site';
---
<div class="widget">
  <div class="widget-title"><i class="icon-code-hub"> 代码仓库</i></div>
  <ul class="codehub-list">
    {site.codehub.map((hub) => (
      <li class="codehub-list-item"><a href={hub.url} title={hub.title} target="_blank" rel="noopener noreferrer">{hub.title}</a></li>
    ))}
  </ul>
</div>
