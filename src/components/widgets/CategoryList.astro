---
// 顺序必须和 Jekyll 的 site.categories 一致（按文章旧→新首次出现），
// 不能用 localeCompare 排序——那会变成 技术 → 杂文，与原站不同。
import { getSortedPosts } from '../../lib/posts';
import { groupPosts } from '../../lib/grouping';

const posts = await getSortedPosts();
const categories = groupPosts(posts, 'category');
---
<div class="widget">
  <div class="widget-title"><i class="icon-category"> 文章分类</i></div>
  <ul class="category-list">
    {[...categories.entries()].map(([name, list]) => (
      <li class="category-list-item">
        <a class="category-list-link" href={`/category/#${name}`}>{name} ({list.length})</a>
      </li>
    ))}
  </ul>
</div>
