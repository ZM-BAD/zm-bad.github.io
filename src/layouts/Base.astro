---
// 移植自 _layouts/base.html
// 类名 / id / 结构全部原样保留，所以 assets/css/style.css 不需要任何改动。
import { site } from '../site';
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  keywords?: string;
  description?: string;
  /** 分享卡片配图，站内绝对路径（如 /images/xxx.webp）。不给则只出一条纯文字卡片 */
  ogImage?: string | null;
  /** 文章页传 'article'，其余默认 'website' */
  ogType?: string;
}

const { title, keywords, description, ogImage, ogType = 'website' } = Astro.props;
const pageTitle = title ?? site.title;
const headTitle = `${pageTitle} | ${site.subtitle}`;
const headKeywords = keywords ?? site.keywords;
const headDescription = description ?? site.description;

// 规范链接：Astro.site 已在 astro.config.mjs 里配成 https://zmbad.me
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = ogImage ? new URL(ogImage, Astro.site).href : null;
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta content="width=device-width, initial-scale=1.0" name="viewport">
  <meta content="yes" name="apple-mobile-web-app-capable">
  <meta content="black-translucent" name="apple-mobile-web-app-status-bar-style">
  <meta content="telephone=no" name="format-detection">

  <title>{headTitle}</title>
  <meta name="keywords" content={headKeywords}>
  <meta name="description" content={headDescription}>
  <meta name="baidu-site-verification" content="fjE6fa4d3J">
  <meta name="author" content={site.author}>
  <link rel="canonical" href={canonical}>
  <meta name="theme-color" content="#F2F2F2">

  <!-- 分享卡片（微信 / Twitter / Telegram / 飞书 等读取这些） -->
  <meta property="og:type" content={ogType}>
  <meta property="og:site_name" content={site.title}>
  <meta property="og:title" content={pageTitle}>
  <meta property="og:description" content={headDescription}>
  <meta property="og:url" content={canonical}>
  <meta property="og:locale" content="zh_CN">
  {ogImageUrl && <meta property="og:image" content={ogImageUrl}>}

  <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'}>
  <meta name="twitter:title" content={pageTitle}>
  <meta name="twitter:description" content={headDescription}>
  {ogImageUrl && <meta name="twitter:image" content={ogImageUrl}>}

  <link rel="Shortcut Icon" type="image/x-icon" href="/favicon.ico">
  <link rel="alternate" type="application/rss+xml" title={site.title} href="/feed.xml">

  <!-- normalize 不单独引：pure-min.css 内部已内嵌 normalize v8.0.1，
       此处原本再引一份 v3.0.2 属重复加载，且版本比内嵌的旧 5 代 -->
  <link rel="stylesheet" type="text/css" href="/assets/css/pure-min.css">
  <link rel="stylesheet" type="text/css" href="/assets/css/grids-responsive-min.css">
  <!-- ?v= 是缓存戳：改过 style.css 就要把这个数字换掉，否则回访用户拿的是旧 CSS。
       上次改动：2026-09-30（精简 @font-face / 删掉 .eot/.ttf/.svg 引用） -->
  <link rel="stylesheet" type="text/css" href="/assets/css/style.css?v=1790698063">

  {site.baiduAnalytics && (
    /* ★ is:inline 会让 Astro 原样吐出这段 script，里面的 ${...} 不会被求值 ——
       之前这里直接写 `${site.baiduAnalytics}`，上线后请求的是
       "hm.js?${site.baiduAnalytics}" 这个字面量，统计一直是死的。
       要用 define:vars 把值传进去（is:inline 与 define:vars 可以共存）。 */
    <script is:inline define:vars={{ baiduId: site.baiduAnalytics }}>
      var _hmt = _hmt || [];
      (function() {
        var hm = document.createElement("script");
        hm.src = "https://hm.baidu.com/hm.js?" + baiduId;
        var s = document.getElementsByTagName("script")[0];
        s.parentNode.insertBefore(hm, s);
      })();
    </script>
  )}
</head>

<body>
  <div class="body_container">
    <Header pageTitle={pageTitle} />

    <div id="layout" class="pure-g">
      <div class="pure-u-1 pure-u-md-3-4">
        <div class="content_container">
          <slot />
        </div>
      </div>

      <div class="pure-u-1-4">
        <div id="sidebar">
          <Sidebar />
        </div>
      </div>
    </div>

    <Footer />

    <a id="rocket" href="#top"></a>
    <script src="/assets/js/totop.js" is:inline></script>
  </div>

  <script is:inline>
    (function(){
      var bp = document.createElement('script');
      bp.src = 'https://zz.bdstatic.com/linksubmit/push.js';
      var s = document.getElementsByTagName("script")[0];
      s.parentNode.insertBefore(bp, s);
    })();
  </script>
</body>
</html>
